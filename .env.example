# JIA - Environment Variables Template\n# Copy this to .env and fill in your actual values\n# IMPORTANT: Never commit .env file to git\n\n# ============================================================================\n# DATABASE CONFIGURATION\n# ============================================================================\nDB_HOST=localhost\nDB_PORT=3306\nDB_USER=root\nDB_PASSWORD=your_mysql_password_here\nDB_NAME=AIuser\n\n# Optional: Use different database for testing\nDB_TEST_HOST=localhost\nDB_TEST_NAME=AIuser_test\n\n# ============================================================================\n# API KEYS & CREDENTIALS\n# ============================================================================\n\n# Google Gemini API Key (get from https://ai.google.dev/)\nGEMINI_API_KEY=your_gemini_api_key_here\n\n# Wolfram Alpha API ID (optional, for advanced calculations)\n# Get from https://www.wolframalpha.com/api/\nWOLFRAM_ALPHA_APP_ID=your_wolfram_app_id_here\n\n# ============================================================================\n# APPLICATION SETTINGS\n# ============================================================================\n\n# Debug mode (True for development, False for production)\nDEBUG=False\n\n# Logging level\nLOG_LEVEL=INFO\n\n# Maximum response words for Gemini API\nMAX_RESPONSE_WORDS=500\n\n# Flask/API server settings (if using web backend)\nFLASK_ENV=production\nFLASH_DEBUG=False\nFLASK_HOST=0.0.0.0\nFLASK_PORT=5000\n\n# ============================================================================\n# SPEECH & AUDIO SETTINGS\n# ============================================================================\n\n# Speech recognition language\nSTT_LANGUAGE=en-IN\n\n# Audio energy threshold (50-300, higher = less sensitive)\nAUDIO_ENERGY_THRESHOLD=300\n\n# Pause threshold in seconds\nAUDIO_PAUSE_THRESHOLD=1.0\n\n# TTS speech rate (50-300 WPM)\nTTS_RATE=150\n\n# Use offline speech recognition? (true/false)\nUSE_OFFLINE_STT=False\n\n# ============================================================================\n# FEATURE FLAGS\n# ============================================================================\n\n# Enable/disable specific features\nFEATURE_NEWS=True\nFEATURE_SPORTS=True\nFEATURE_TRANSLATION=True\nFEATURE_GAMES=True\nFEATURE_DICTIONARY=True\nFEATURE_ALARMS=True\nFEATURE_CALCULATOR=True\n\n# ============================================================================\n# CLOUD DEPLOYMENT (Optional)\n# ============================================================================\n\n# AWS Configuration (if deploying to AWS)\nAWS_ACCESS_KEY_ID=your_aws_access_key\nAWS_SECRET_ACCESS_KEY=your_aws_secret_key\nAWS_REGION=us-east-1\nAWS_S3_BUCKET=your_s3_bucket_name\n\n# Google Cloud Configuration\nGCLOUD_PROJECT_ID=your_gcloud_project\nGCLOUD_CREDENTIALS_PATH=/path/to/credentials.json\n\n# ============================================================================\n# SECURITY\n# ============================================================================\n\n# Secret key for sessions (generate with: python -c \"import secrets; print(secrets.token_hex(16))\")\nSECRET_KEY=your_secret_key_here\n\n# Session timeout in minutes\nSESSION_TIMEOUT=30\n\n# Enable HTTPS/SSL (True for production)\nUSE_SSL=False\n\n# ============================================================================\n# LOGGING & MONITORING\n# ============================================================================\n\n# Log file path\nLOG_FILE=jia_app.log\n\n# Sentry DSN for error tracking (optional)\nSENTRY_DSN=your_sentry_dsn_here\n\n# Enable detailed logging?\nDETAIL_LOGGING=False\n\n# ============================================================================\n# DEVELOPMENT SETTINGS\n# ============================================================================\n\n# Show SQL queries in logs?\nSHOW_SQL_LOGS=False\n\n# Enable hot reload for development?\nHOT_RELOAD=True\n\n# Mock external APIs for testing?\nMOCK_APIS=False\n\n# ============================================================================\n# INSTRUCTIONS\n# ============================================================================\n#\n# 1. Copy this file to .env:\n#    cp .env.example .env\n#\n# 2. Edit .env with your actual values:\n#    - Your MySQL credentials\n#    - Your API keys\n#    - Application settings\n#\n# 3. Load in Python code:\n#    from dotenv import load_dotenv\n#    import os\n#    load_dotenv()\n#    db_host = os.getenv('DB_HOST')\n#\n# 4. Load in bash:\n#    export $(cat .env | xargs)\n#\n# 5. NEVER commit .env to git:\n#    echo \".env\" >> .gitignore\n#\n# ============================================================================\n# SECURITY BEST PRACTICES\n# ============================================================================\n#\n# ✓ Always use strong, unique passwords\n# ✓ Rotate API keys regularly\n# ✓ Never commit .env to version control\n# ✓ Use different keys for dev/prod/test\n# ✓ Keep API keys out of logs\n# ✓ Use environment-specific configurations\n# ✓ Enable SSL/TLS for production\n# ✓ Monitor for suspicious activity (Sentry)\n#\n# ============================================================================\n"