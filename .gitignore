# Python Virtual Environments\nvenv/\nENV/\nenv/\n.venv\npython-venv/\n\n# Python Bytecode & Cache\n__pycache__/\n*.py[cod]\n*$py.class\n*.so\n.Python\nbuild/\ndevelop-eggs/\ndist/\ndownloads/\neggs/\n.eggs/\nlib/\nlib64/\nparts/\nsdist/\nvar/\nwheels/\npip-wheel-metadata/\nshare/python-wheels/\n*.egg-info/\n.installed.cfg\n*.egg\nPIPFILE.lock\n\n# Environment & Configuration\n.env\n.env.local\n.env.*.local\n.env.prod\n.env.dev\nconfig.ini\nsettings.local.py\n\n# IDE & Editors\n.vscode/\n.idea/\n*.swp\n*.swo\n*~\n.DS_Store\n.project\n.pydevproject\n.settings/\n*.sublime-project\n*.sublime-workspace\n.atom/\n.emacs.d/\nvim/.backup/\nvim/.swap/\nvim/.undo/\n\n# Logs\n*.log\nlogs/\n*.log.*\nlog.txt\n\n# Database\n*.db\n*.sqlite\n*.sqlite3\n*.sqlitedb\n.mysql_history\nmysql-error.log\n\n# Testing\n.tox/\n.coverage\n.coverage.*\n.cache\n.pytest_cache/\nnosetests.xml\ncoverage.xml\n*.cover\n.hypothesis/\n\n# Type Checking\n.mypy_cache/\n.dmypy.json\ndmypy.json\n.pyre/\n.pytype/\n\n# Profiling\nprofile_output/\n*.prof\n*.lprof\n\n# Build artifacts\nJIA.spec\nbuild/\ndist/\n*.egg-info/\n.eggs/\n*.whl\n\n# Audio/Media Files\n*.mp3\n*.wav\n*.flac\n*.wma\n*.m4a\n*.aac\n*.ogg\n*.mp4\n*.avi\n*.mkv\n*.mov\naudio_cache/\n\n# User/Application Data\nRemember.txt\n.history/\nuser_data/\nlocal_data/\n*.tmp\n*.temp\n*.backup\n*.bak\n*.swp\n\n# OS Specific\n.DS_Store\nThumbs.db\n.DS_Store?\n._*\n.Spotlight-V100\n.Trashes\nehthumbs.db\n\n# IDE Generated\n.classpath\n.factorypath\n.project\n.settings\n*.iml\n.idea/\n*.sublime-project\n*.sublime-workspace\n\n# Temporary Files\n*.tmp\n*.temp\n*.bak\n.~\n*~\n\n# Compiled Files\n*.pyc\n*.pyo\n*.pyd\n\n# Production/Deployment\njia.exe\njia.app\ndist/\nrelease/\nartifact/\n\n# Database Dumps\n*.sql.bak\n*.sql.gz\n*.dump\n\n# Node modules (if using JS tools)\nnode_modules/\nnpm-debug.log\nyarn-error.log\n\n# Client secrets\nsecrets.json\ncredentials.json\nprivate_key.pem\n*.key\n*.pem\n\n# Temporary test files\ntest_output/\ntest_results/\n\n# Documentation builds\ndocs/_build/\nsite/\n\nGemfile.lock\nPipfile.lock\npoetry.lock\n\n# Mac OS X\n.AppleDouble\n.LSOverride\n\n# Windows\ndesktop.ini\n$RECYCLE.BIN/\nehthumbs.db\nThumbs.db\n\n# Linux\n.directory\n\n# Virtual Studio Code\n.vscode/settings.json\n.vscode/tasks.json\n.vscode/launch.json\n.vscode/extensions.json\n.vscode/*.code-workspace\n\n# Jupyter Notebook\n.ipynb_checkpoints\n*.ipynb_checkpoints\n\n# Temporary pytest cache\n.pytest_cache/\n\n# Performance profiling\n.prof\n.lprof\nprofile_output.txt\n\n# Data files\n*.csv\n*.xlsx\n*.xls\n*.json.bak\n\n# Keep these important files\n!.gitkeep\n!.gitignore\n!requirements*.txt\n!.env.example\n"

